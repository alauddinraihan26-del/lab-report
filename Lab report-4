#include<bits/stdc++.h>
using namespace std;


void f(int n,int amount,vector<int> coins) {
    int cc[n+1][amount+1];
    for(int i=0; i<=n; i++) {
        cc[i][0]=0;
    }
    for(int j=1; j<=amount; j++) {
        cc[0][j]=INT_MAX;
    }
    for(int i=1; i<=n; i++) {
        for(int j=1; j<=amount; j++) {
            if(j>=coins[i-1]) {
                cc[i][j]=min(cc[i-1][j],1+cc[i][j-coins[i-1]]);
            } else {
                cc[i][j]=cc[i-1][j];
            }
        }
    }
    cout << "Minimum coins : " << endl;
    cout << cc[n][amount] << endl;
    int i=n,j=amount;
    cout << "Items : "<< endl;
    while(i>0&&j>0) {
        if(cc[i][j]==cc[i-1][j]) i--;
        else {
            cout << coins[i-1] << endl;
            j-=coins[i-1];
        }
    }
}

int main() {
    int n,amount; cin >> n >> amount;
    vector<int> c(n);
    for(int &i : c) {
        cin >> i;
    }
    f(n,amount,c);
}
