#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;

int knapsack(int size, vector<char>&items, vector<int>&profit, vector<int>&weight, int capacity)
{
    vector<vector<int> >ks(size+1, vector<int>(capacity+1, 0));

    for(int i=1; i<=size; i++)
    {
        for (int j=1; j<=capacity; j++)
        {
            if(j>=weight[i-1])
            {
                ks[i][j]=max(ks[i-1][j], profit[i-1]+ks[i-1][j-weight[i-1]]);
            }
            else
            {
                ks[i][j]=ks[i-1][j];
            }
        }
    }
    int restofprofit = ks[size][capacity];
    int restofweight = capacity;
    cout << "Chosen items: ";
    for(int i=size; i>0 && restofprofit>0; i--)
    {
        if(restofprofit == ks[i-1][restofweight])
        {
            continue;
        }
        else
        {
            cout << items[i-1] << " ";
            restofprofit -= profit[i-1];
            restofweight -= weight[i-1];
        }
    }
    cout << endl;

    return ks[size][capacity];
}
int main()
{
    int size;
    cout<< "Enter the size: ";
    cin>> size;

    vector<char> items(size);
    vector<int> profit(size), weight(size);
    for(int i=0; i<size; i++)
    {
        cout<< "Enter the item number-"<<i+1<< ":";
        cin>> items[i];

        cout<< "Enter the profit of-"<<i+1<< ":";
        cin>> profit[i];

        cout<< "Enter the weight of-"<<i+1<< ":";
        cin>> weight[i];
    }

    int capacity;
    cout<< "Enter the capacity: ";
    cin>> capacity;

    int result= knapsack(size, items, profit, weight, capacity);
    cout<< "Total profit: "<< result<< endl;

    return 0;
}
