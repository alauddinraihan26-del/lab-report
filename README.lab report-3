#include<iostream>
#include<vector>
#include<algorithm>
#include<climits>
using namespace std;
 
int CoinChange(int size, vector<char> &items, vector<int> &coins, int amount)
{
    vector<vector<int> >CC(size+1, vector<int>(amount+1, INT_MAX-1));
 
    for(int i=1; i<=size; i++)
    {
        CC[i][0]=0;
    }
 
    for(int i=1; i<=size; i++)
    {
        for (int j=1; j<=amount; j++)
        {
            if(j>=coins[i-1])
            {
                CC[i][j]=min(CC[i-1][j], 1+CC[i][j-coins[i-1]]);
            }
            else
            {
                CC[i][j]=CC[i-1][j];
            }
        }
    }
 
    int rov = amount;
    cout << "Chosen coins: ";
 
 
    for (int i = size; i > 0 && rov > 0; )
    {
 
    if (CC[i][rov] == CC[i-1][rov])
    {
        i--;
    }
    else
    {
 
        cout << coins[i-1] << " ";
 
 
        rov -= coins[i-1];
    }
}
cout << endl;
 
    return CC[size][amount];
}
int main()
{
    int size;
    cout<< "Enter the size: ";
    cin>> size;
 
    vector<char> items(size);
    vector<int>  coins(size);
    for(int i=0; i<size; i++)
    {
        cout<< "Enter the item number-"<<i+1<< ":";
        cin>> items[i];
 
        cout<< "Enter the coins of-"<<i+1<< ":";
        cin>> coins[i];
    }
 
    int amount;
    cout<< "Enter the amount: ";
    cin>> amount;
 
    int result= CoinChange(size, items, coins, amount);
    cout<< "Minimum coins needed: "<< result<< endl;
 
    return 0;
}
