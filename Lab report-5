#include<bits/stdc++.h>
using namespace std;

void f(int n,int amount,vector<int> coins) {
    int dp[n+1][amount+1];
    for(int i=0; i<=n; i++) {
        dp[i][0]=1;
    }
    for(int i=1; i<=amount; i++) {
        dp[0][i]=0;
    }
    for(int i=1; i<=n; i++) {
        for(int j=1; j<=amount; j++) {
            if(j>=coins[i-1]) {
                dp[i][j]=dp[i-1][j]+dp[i][j-coins[i-1]];
            } else {
                dp[i][j]=dp[i-1][j];
            }
        }
    }
    cout << dp[n][amount];
}

void solve() {
    int n,amount; 

    cin >> n ;
    vector<int> c(n);
    for(int &i : c) {
        cin >> i;
    }
    cin>> amount;
    f(n,amount,c);
}

int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    solve();
    
}
