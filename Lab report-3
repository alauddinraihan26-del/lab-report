#include<bits/stdc++.h>
using namespace std;


void f(int w,vector<int> weight,vector<int> values,int n) {
    vector<vector<int>> dp(n+1,vector<int> (w+1,0));
    for(int i=1; i<=n; i++) {
        for(int j=1; j<=w; j++) {
            if(weight[i-1]<=j) {
                dp[i][j]=max(values[i-1]+dp[i-1][j-weight[i-1]],dp[i-1][j]);
            } else dp[i][j]=dp[i-1][j];
        }
    }
    cout << "Maximum Value: " << dp[n][w] << endl;
    cout << "Items : ";
    int j=w;
    for(int i=n; i>0; i--) {
        if(dp[i][j]==dp[i-1][j]) continue;
        else {
            cout << i << endl;
            j-=weight[i-1];
        }
    }
}

int main() {
    int n,w; cin >> n >> w;
    vector<int> values(n),weight(n);
    for(int &i : values) {
        cin >> i;
    }
    for(int &i : weight) {
        cin >> i;
    }
    f(w,weight,values,n);
}
