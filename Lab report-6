#include<bits/stdc++.h>
using namespace std;

string lcs(const string& s1, const string& s2) {
    int a = s1.length();
    int b = s2.length();
    vector<vector<int>> dp(a + 1, vector<int>(b + 1, 0));

    for (int i = 1; i <= a; i++) {
        for (int j = 1; j <= b; j++) {
            if (s1[i-1] == s2[j-1])
                dp[i][j] = dp[i-1][j-1] + 1;
            else
                dp[i][j] = max(dp[i-1][j], dp[i][j-1]);
        }
    }

    // Backtrack to find the LCS string
    string result = "";
    int i = a, j = b;
    while (i > 0 && j > 0) {
        if (s1[i-1] == s2[j-1]) {
            result += s1[i-1];
            i--; j--;
        } else if (dp[i-1][j] > dp[i][j-1]) {
            i--;
        } else {
            j--;
        }
    }
    reverse(result.begin(), result.end());

    cout << "LCS length : " << dp[a][b] << "\n";
    cout << "LCS string : " << result << "\n";
    return result;
}

int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    string s1, s2;
    cin >> s1 >> s2;
    lcs(s1, s2);
    return 0;
}
