#include<bits/stdc++.h>
using namespace std;

void f(string s1, string s2) {
    int a = s1.length();
    int b = s2.length();
    vector<vector<int>> dp(a + 1, vector<int>(b + 1, 0));

    for (int i = 1; i <= a; i++) {
        for (int j = 1; j <= b; j++) {
            if (s1[i - 1] == s2[j - 1]) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
    }

    cout << "LCS : ";
    cout << dp[a][b] << endl;

    string lcs = "";
    int i = a, j = b;
    while (i > 0 && j > 0) {
        if (s1[i - 1] == s2[j - 1]) {
            lcs += s1[i - 1];
            i--;
            j--;
        } else if (dp[i - 1][j] > dp[i][j - 1]) {
            i--;
        } else {
            j--;
        }
    }
    reverse(lcs.begin(), lcs.end());

    cout << "LCS chars... : ";
    cout << lcs << endl;
}

void solve() {
    string s1, s2;
    cin >> s1 >> s2;
    f(s1, s2);
}

int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    solve();
    return 0;
}
